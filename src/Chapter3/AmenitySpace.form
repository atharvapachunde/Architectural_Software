        <Property name="text" type="java.lang.String" editor="org.netbeans.modules.form.RADConnectionPropertyEditor">
          <Connection code="&quot;&lt;html&gt;The landowner must develop the amenity space for specific public uses such as gardens, playgrounds, schools, &lt;br&gt; hospitals, fire brigades, or housing for displaced persons.&lt;/html&gt;&quot;" type="code"/>
        </Property>
