        <Property name="text" type="java.lang.String" editor="org.netbeans.modules.form.RADConnectionPropertyEditor">
          <Connection code="&quot;&lt;html&gt;If the Authority takes over the amenity space, the landowner gets additional Floor Space Index (FSI) in-situ(on the &lt;br&gt; remaining land) or Transferable Development Rights (TDR).&lt;/html&gt;&quot;" type="code"/>
