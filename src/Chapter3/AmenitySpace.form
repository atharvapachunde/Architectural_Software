        <Property name="text" type="java.lang.String" editor="org.netbeans.modules.form.RADConnectionPropertyEditor">
          <Connection code="&quot;&lt;html&gt;This regulation shall not be applicable where separate amenity space is mandated by the Government, while &lt;br&gt; sanctioning modification proposal under section  37 or 20 of the Act.&lt;/html&quot;" type="code"/>
