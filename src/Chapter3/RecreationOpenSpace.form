      <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
      <SubComponents>
        <Component class="javax.swing.JTextArea" name="jTextArea1">
          <Properties>
            <Property name="background" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="f2" green="f2" red="f2" type="rgb"/>
            </Property>
            <Property name="columns" type="int" value="20"/>
            <Property name="rows" type="int" value="5"/>
            <Property name="text" type="java.lang.String" value="Any land/plot admeasuring 0.4 ha. or more, 10% of area shall be enmarked as Recreational Open Space, mostly in &#xa;one place.&#xa;Incase land/plot is admeasuring more than 0.8 ha., the recreational open space can be provided in different location. &#xa;Owner can provide more than 10% of recreational open space.&#xa;&#xa;For the lands which are sub-divided after 11th January, 1967 without taking prior permission from the Authority and &#xa;having plot area below 0.4 ha., the applicant may opt for any of the options from :- &#xa;a) providing 10% open space subject to a minimum of  200 sq.m., or  &#xa;b) availing the reduced FSI of 75% of the basic FSI as otherwise permissible on such land.  &#xa;c) avail full basic FSI and other permissible FSI / TDR by paying 10% value of the land &#xa;under proposal as per Annual Statement of Ratesfor that year, without considering &#xa;guidelines therein. &#xa;&#xa;Not more than 50% of Recreational Space to provided on terrace of podium. Owner can provide 100% recreational open &#xa;space on the terrace only if 1.5 m. strip provided along the boundary of terrace.&#xa;&#xa;If a surplus or retainable land under the Urban Land (C. &amp; R.) Act, 1976, is 0.4 hectares or more, 10% of it must be reserved as &#xa;recreational open space.&#xa;&#xa;Open Space to be provided for any use/zone &#xa;&#xa;No Recreational Open space to be provided for land/plot of area upto 0.4 ha.&#xa;Recreational open space is not required for:&#xa;a) Subdivision of plots from an already sanctioned layout.&#xa;b) Development of non-residential reservations in Development Plans.&#xa;c) Non-residential, non-industrial, and non-educational uses in the Agricultural zone.&#xa;"/>
          </Properties>
        </Component>
      </SubComponents>
    </Container>
    <Container class="javax.swing.JScrollPane" name="jScrollPane5">
      <Properties>
